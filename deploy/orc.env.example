# Orc[hestrator] server environment — copy to ~/.config/orc/orc.env
# and fill in the values for your host. Consumed by deploy/orc.service
# (EnvironmentFile=-%h/.config/orc/orc.env), which runs `orc-serve`
# (streamable-http transport).

# --- Core ---------------------------------------------------------------
# SQLite database path. Default when unset: ~/.orc/tasks.db
ORC_DB=/home/claudio/.local/share/orc/tasks.db
# Note-schema (gates) config file. Default when unset:
# .taskorchestrator/config.yaml relative to the working directory.
#ORC_CONFIG=

# Legacy names still work as a fallback with a deprecation warning:
# TASK_ORCHESTRATOR_DB / TASK_ORCHESTRATOR_CONFIG.

# --- HTTP transport (orc-serve) ------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8005
# MCP_TRANSPORT remains an override only (ADR-007); not needed for orc-serve.

# --- Auth (read by the service) -------------------------------------------
# Seeds the initial admin user on first boot, when no user exists yet.
# Set both, or neither (login disabled until a user is created some other way).
#ORC_ADMIN_USER=
#ORC_ADMIN_PASSWORD=
# OAuth2 resource-server mode for MCP clients (second barrier behind the
# proxy's basic auth): set MCP_OAUTH_ENABLED=1 and MCP_OAUTH_TOKENS as a
# persona->secret mapping.
#MCP_OAUTH_ENABLED=
#MCP_OAUTH_TOKENS=
# Force the session cookie's Secure flag behind a TLS proxy.
ORC_COOKIE_SECURE=1
# Session TTL in hours (default 168 = 7 days).
#ORC_SESSION_TTL_HOURS=168

# --- Optional -------------------------------------------------------------
# Fallback identity for writes when no X-Agent-ID header is present.
#MCP_AGENT_ID=
# Serve the lightweight server-rendered board in the same process.
#MCP_UI_ENABLED=1
#MCP_UI_HOST=127.0.0.1
#MCP_UI_PORT=8080
