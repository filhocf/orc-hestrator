# Override the API base URL (default: "/api", proxied by the Vite dev server).
# Example for pointing straight at a remote Orc without the dev proxy:
# VITE_API_BASE=https://cfnarede.dev/orc/api
# VITE_API_BASE=/api

# Override the dev-server proxy target (default: http://127.0.0.1:8005).
# VITE_API_PROXY_TARGET=http://127.0.0.1:8005
